{
  "name": "playwright-ai-automation",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "AI-native quality engineering showcase: grounded planning, guarded generation, failure investigation and deterministic commerce automation.",
  "scripts": {
    "test": "playwright test --project=api --project=framework --project=chromium --project=firefox --project=webkit --project=mobile-chrome",
    "test:ui": "playwright test tests/ui --project=chromium",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test tests/e2e --project=chromium",
    "test:smoke": "playwright test --grep @smoke --project=api --project=chromium",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run typecheck && npm run lint && npm run format:check",
    "dev": "npm run demo:app",
    "demo:app": "node --import tsx demo/server.ts",
    "test:framework": "playwright test --project=framework",
    "test:a11y": "playwright test tests/accessibility --project=chromium",
    "test:security": "playwright test tests/security --project=api",
    "test:resilience": "playwright test tests/resilience --project=chromium",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "ai:demo": "node --import tsx scripts/ai-run.ts",
    "ai:live": "node --import tsx scripts/ai-run.ts --live",
    "showcase:build": "node --import tsx scripts/build-showcase.ts",
    "showcase": "node --import tsx scripts/serve-showcase.ts",
    "verify": "npm run quality && npm test && npm run ai:demo && npm run ai:candidates && npm run ai:evaluate && npm run test:showcase",
    "test:showcase": "npm run showcase:build && playwright test --config=playwright.showcase.config.ts",
    "ai:candidates": "node --import tsx scripts/ai-candidates.ts",
    "ai:candidates:live": "node --import tsx scripts/ai-candidates.ts --live",
    "ai:evaluate": "node --import tsx scripts/ai-evaluate.ts",
    "aws:check": "node scripts/check-aws-template.mjs",
    "aws:summary": "node scripts/aws-summary.mjs",
    "ai:check": "node --import tsx scripts/check-ai.ts",
    "db:local:start": "node --import tsx scripts/db-local.ts start",
    "db:local:stop": "node --import tsx scripts/db-local.ts stop",
    "demo:postgres": "node --import tsx demo/durable-server.ts",
    "test:postgres": "playwright test --config=playwright.postgres.config.ts",
    "ai:review": "node --import tsx scripts/review-candidates.ts",
    "ai:evaluate-approved": "node --import tsx scripts/evaluate-approved.ts",
    "contract:check": "node --import tsx scripts/check-contract.ts",
    "verify:v3": "npm run quality && npm run contract:check && npm test && npm run ai:demo && npm run ai:candidates && npm run ai:evaluate && npm run test:postgres && npm run test:showcase",
    "journeys:evaluate": "node --import tsx scripts/journeys.ts",
    "verify:v4": "npm run quality && npm run contract:check && npm test && npm run ai:demo && npm run ai:candidates && npm run ai:evaluate && npm run test:postgres && npm run test:showcase",
    "showcase:launch": "node --import tsx scripts/launch-showcase.ts",
    "showcase:replay": "node --import tsx scripts/replay-showcase.ts",
    "verify:v5": "npm run quality && npm run contract:check && npm test && npm run ai:demo && npm run ai:candidates && npm run ai:evaluate && npm run test:postgres && npm run test:showcase"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^16.4.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "openai": "^7.52.0",
    "pg": "^8.23.1",
    "prettier": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
