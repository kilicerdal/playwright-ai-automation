{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "demo/**/*.ts",
    "scripts/**/*.ts",
    "playwright.showcase.config.ts",
    "playwright.visual.config.ts",
    "playwright.merge.config.ts",
    "playwright.postgres.config.ts"
  ]
}
