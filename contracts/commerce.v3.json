  "components": {
    "schemas": {
      "Product": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "price": {
            "type": "integer",
            "minimum": 1
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          },
          "glyph": {
            "type": "string"
          },
          "color": {
            "type": "string"
          }
        },
        "required": ["id", "name", "category", "price", "stock", "glyph", "color"]
      },
      "Cart": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "productId": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "product": {
                  "$ref": "#/components/schemas/Product"
                }
              },
              "required": ["productId", "quantity", "product"]
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["items", "total", "count"]
      },
      "Order": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "total": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": ["confirmed", "cancelled", "refunded"]
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "productId": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "unitPrice": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": ["productId", "quantity", "unitPrice"]
            }
          }
        },
        "required": ["id", "total", "status", "items"]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["error", "requestId"]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "enum": ["demo", "buyer2"]
              },
              "name": {
                "type": "string"
              }
            },
            "required": ["id", "name"]
          },
          "csrf": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["user", "csrf"]
      },
      "Shipping": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80,
            "description": "Constraints apply after server-side trimming."
          },
          "address": {
            "type": "string",
            "minLength": 5,
            "maxLength": 200,
            "description": "Constraints apply after server-side trimming."
          }
        },
        "required": ["name", "address"]
      }
    },
